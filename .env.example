# Resend (https://resend.com/api-keys) - sends support tickets by email
RESEND_API_KEY=

# Where tickets are delivered (defaults to ahidsoftlabs@gmail.com)
SUPPORT_TO_EMAIL=ahidsoftlabs@gmail.com

# Sender address. The default (onboarding@resend.dev) only delivers to the email
# that owns the Resend account. Verify ahid.io in Resend, then use e.g.
# "Ahid Support <support@ahid.io>".
SUPPORT_FROM_EMAIL=Ahid Support <onboarding@resend.dev>
